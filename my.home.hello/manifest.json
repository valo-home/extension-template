  "blocks": [
    {"key": "round", "kind": "trig", "icon": "spark", "name": {"en": "Hello: round number", "uk": "Привіт: кругле число", "ru": "Привет: круглое число"}}
  ],
  "pages": [
    {"key": "hello", "icon": "spark", "level": "declarative", "name": {"en": "Hello", "uk": "Привіт", "ru": "Привет"}}
  ],
  "runtime": {"memory": 64, "cpu": 10}
}
